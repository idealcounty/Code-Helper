CODE_HELPER_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
CODE_HELPER_BASE_URL=https://api.deepseek.com
CODE_HELPER_MODEL=deepseek-v4-flash

# Minimal trusted-user Windows server mode.
CODE_HELPER_HOST=0.0.0.0
CODE_HELPER_PORT=8765
CODE_HELPER_ACCESS_USERNAME=codehelper
CODE_HELPER_ACCESS_PASSWORD=replace-with-a-long-random-password

# Remote users can only open projects below this directory.
CODE_HELPER_WORKSPACE_ROOT=D:/CodeHelper/workspaces
CODE_HELPER_SETTINGS_PATH=D:/CodeHelper/data/settings.json

CODE_HELPER_THINKING_MODE=enabled
CODE_HELPER_REASONING_EFFORT=high
CODE_HELPER_MAX_STEPS=160
CODE_HELPER_REQUEST_TIMEOUT=120
CODE_HELPER_COMMAND_TIMEOUT=60
CODE_HELPER_RUN_TIMEOUT=4800
