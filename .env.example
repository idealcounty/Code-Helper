CODE_HELPER_PROVIDER=deepseek
DEEPSEEK_API_KEY=
CODE_HELPER_BASE_URL=https://api.deepseek.com
CODE_HELPER_MODEL=deepseek-v4-flash
CODE_HELPER_THINKING_MODE=enabled
CODE_HELPER_REASONING_EFFORT=high
CODE_HELPER_MAX_STEPS=20
CODE_HELPER_REQUEST_TIMEOUT=120
CODE_HELPER_COMMAND_TIMEOUT=60
CODE_HELPER_RUN_TIMEOUT=600
# Optional provider-reported Token limit for one Agent turn.
# CODE_HELPER_TOKEN_BUDGET=50000
# Optional cumulative Token limit across independent turns in one session.
# CODE_HELPER_SESSION_TOKEN_BUDGET=200000
# Optional hard cap for one provider completion. The effective max_tokens is
# the smallest of this value and the remaining Turn/Session Token budget.
# CODE_HELPER_MAX_OUTPUT_TOKENS=8192

# Local full-tool-output retention limits (oldest references are pruned first).
CODE_HELPER_RESULT_STORE_MAX_BYTES=50000000
CODE_HELPER_RESULT_STORE_MAX_FILES=512

# Session event retention limits (the active session is never pruned).
CODE_HELPER_EVENT_STORE_MAX_BYTES=100000000
CODE_HELPER_EVENT_STORE_MAX_FILES=256

# Optional global user memory. Disabled by default and stored outside projects.
CODE_HELPER_USER_MEMORY_ENABLED=false
# CODE_HELPER_USER_MEMORY_DIR=C:/Users/you/AppData/Local/CodeHelper/user-memory
